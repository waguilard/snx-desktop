[Unit]
Description=SNX Desktop - DNS corporativo por dominio
After=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/snx-desktop-dns.py
Restart=on-failure
RestartSec=5
UMask=0077
RuntimeDirectory=snx-desktop-dns
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/resolv.conf /var/lib/snx-desktop-dns /run/snx-desktop-dns
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_KILL CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
